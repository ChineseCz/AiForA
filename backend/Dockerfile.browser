# Browser Worker 镜像：基于官方 Playwright 镜像，含 Chromium + 所有系统依赖。
# 仅供 browser-worker 服务使用，API/worker/beat 继续用 Dockerfile（不含浏览器）。
FROM mcr.microsoft.com/playwright/python:v1.48-jammy

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 先装依赖，利用层缓存
COPY requirements.txt ./
RUN pip install -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

# 再装 playwright python 包（浏览器二进制已在基础镜像里，无需 playwright install）
RUN pip install "playwright>=1.40" -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

# 拷贝代码
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./
COPY scripts ./scripts

EXPOSE 8000

CMD ["celery", "-A", "app.workers.celery_app", "worker", "-Q", "browser", "--pool=solo", "--loglevel=info"]
