# 复制为 backend/.env 填入真实值。

# ===== 数据库 / Redis =====
# 本地开发（连 docker compose 发布出来的端口）：
DATABASE_URL=postgresql+asyncpg://natapp:natapp@localhost:5432/natapp
REDIS_URL=redis://localhost:6379/0
# 在 api 容器内则用服务名：
# DATABASE_URL=postgresql+asyncpg://natapp:natapp@postgres:5432/natapp
# REDIS_URL=redis://redis:6379/0

# ===== Postgres 容器初始化（docker-compose 用）=====
POSTGRES_USER=natapp
POSTGRES_PASSWORD=natapp
POSTGRES_DB=natapp

# ===== 中转站 API =====
RELAY_API_KEY=your-relay-api-key
RELAY_API_URL=https://www.micuapi.ai/v1
RELAY_MODEL=gpt-5.4-mini
VISION_MODEL=

# ===== 管理员鉴权（Phase 3）=====
# 生产：JWT_SECRET 用强随机值；建议不在 env 放密码，改用 scripts/create_admin.py 建号。
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== 雪球（Phase 2 宿主 worker）=====
XUEQIU_COOKIE=
MAX_PAGES=10
FETCH_FULL_TEXT=true
REQUEST_DELAY=1.5
HEADLESS=false

# ===== 路径 =====
DATA_DIR=../data
REPORTS_DIR=../reports
