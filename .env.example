# 复制本文件为 .env 并填入真实值。.env 不要提交到公开仓库。

# ===== 中转站 API（OpenAI 兼容接口）=====
RELAY_API_KEY=your-relay-api-key
RELAY_API_URL=https://www.micuapi.ai/v1
RELAY_MODEL=gpt-5.4-mini

# ===== 雪球配置 =====
XUEQIU_COOKIE=
XUEQIU_USERS=https://xueqiu.com/u/1234567890

# ===== 抓取参数 =====
MAX_PAGES=10
FETCH_FULL_TEXT=true
REQUEST_DELAY=1.5
